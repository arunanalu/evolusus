{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Série mensal do IPH médio do RJ. A fonte Gold é preliminar e não representa índice validado.",
  "title": "IPH médio por competência — RJ/2025 (preliminar)",
  "data": {
    "url": "export.csv",
    "format": { "type": "csv" }
  },
  "transform": [
    {
      "calculate": "toDate(datum.ANO_COMPETENCIA + '-' + datum.MES_COMPETENCIA + '-01')",
      "as": "data"
    }
  ],
  "mark": { "type": "line", "point": true, "color": "#005f73" },
  "encoding": {
    "x": { "field": "data", "type": "temporal", "title": "Mês" },
    "y": {
      "field": "INDICE_PRESSAO_HOSPITALAR",
      "type": "quantitative",
      "aggregate": "mean",
      "title": "IPH médio"
    },
    "tooltip": [
      { "field": "data", "type": "temporal", "title": "Competência" },
      {
        "field": "INDICE_PRESSAO_HOSPITALAR",
        "type": "quantitative",
        "aggregate": "mean",
        "title": "IPH médio",
        "format": ".2f"
      },
      {
        "field": "CODIGO_MUNICIPIO_7D",
        "type": "quantitative",
        "aggregate": "count",
        "title": "Municípios"
      }
    ]
  }
}
